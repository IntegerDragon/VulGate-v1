+static json_objectt function_metadata(
+  const irep_idt &name,
+  const goto_functiont &function)
+{
+  const bool is_internal = name.starts_with(CPROVER_PREFIX) ||
+                           name.starts_with("java::array[") ||
+                           name.starts_with("java::org.cprover") ||
+                           name.starts_with("java::java");
+  auto parameter_ids =
+    make_range(
+      function.parameter_identifiers.begin(),
+      function.parameter_identifiers.end())
+      .map([](const irep_idt &id) { return json_stringt{id}; });
+  return json_objectt{
+    {"name", json_stringt(name)},
+    {"isBodyAvailable", jsont::json_boolean(function.body_available())},
+    {"isInternal", jsont::json_boolean(is_internal)},
+    {"isHidden", jsont::json_boolean(function.is_hidden())},
+    {"parameterIdentifiers", json_arrayt{parameter_ids.begin(), parameter_ids.end()}}};
+}
+
+static json_objectt instruction_json(
+  const goto_programt::instructiont &instruction,
+  const json_irept &irep_converter)
+{
+  json_objectt result{
+    {"instructionId", json_stringt(instruction.to_string())},
+    {"locationNumber", json_numbert{std::to_string(instruction.location_number)}},
+    {"sourceLocationIrep", irep_converter.convert_from_irep(instruction.source_location())}};
+  if(instruction.source_location().is_not_nil())
+    result["sourceLocation"] = json(instruction.source_location());
+  std::ostringstream text;
+  instruction.output(text);
+  result["instruction"] = json_stringt(text.str());
+  if(instruction.code().is_not_nil())
+    result["code"] = irep_converter.convert_from_irep(instruction.code());
+  if(instruction.has_condition())
+    result["guard"] = irep_converter.convert_from_irep(instruction.condition());
+  if(!instruction.targets.empty())
+  {
+    auto targets = make_range(instruction.targets.begin(), instruction.targets.end())
+                     .map([](const goto_programt::targett &target) {
+                       return json_numbert{std::to_string(target->location_number)};
+                     });
+    result["targets"] = json_arrayt{targets.begin(), targets.end()};
+  }
+  if(!instruction.labels.empty())
+  {
+    auto labels = make_range(instruction.labels.begin(), instruction.labels.end())
+                    .map([](const irep_idt &id) { return json_stringt{id}; });
+    result["labels"] = json_arrayt{labels.begin(), labels.end()};
+  }
+  return result;
+}
