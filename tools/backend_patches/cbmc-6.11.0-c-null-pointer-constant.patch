+// C integer constant expressions are more restrictive than expressions that
+// simplify to a constant. In particular, x * 0 is not an integer constant
+// expression. Test the typed operands before performing algebraic folding.
+static bool is_c_integer_constant_expression(const exprt &expr)
+{
+  const auto &type = expr.type().id();
+  if(
+    type != ID_signedbv && type != ID_unsignedbv && type != ID_bool &&
+    type != ID_c_bool && type != ID_c_enum_tag)
+    return false;
+
+  if(expr.is_constant())
+    return true;
+
+  if(expr.id() == ID_typecast && expr.operands().size() == 1)
+  {
+    const auto &op = to_typecast_expr(expr).op();
+    // C permits a floating constant as the immediate operand of an
+    // integer cast, but not floating arithmetic inside that cast.
+    if(op.is_constant() && op.type().id() == ID_floatbv)
+      return true;
+    return is_c_integer_constant_expression(op);
+  }
+
+  const auto &id = expr.id();
+  if(
+    id != ID_unary_plus && id != ID_unary_minus && id != ID_bitnot &&
+    id != ID_not && id != ID_plus && id != ID_minus && id != ID_mult &&
+    id != ID_div && id != ID_mod && id != ID_shl && id != ID_lshr &&
+    id != ID_ashr && id != ID_equal && id != ID_notequal && id != ID_lt &&
+    id != ID_le && id != ID_gt && id != ID_ge && id != ID_bitand &&
+    id != ID_bitxor && id != ID_bitor && id != ID_and && id != ID_or &&
+    id != ID_if)
+    return false;
+
+  return std::all_of(
+    expr.operands().begin(), expr.operands().end(),
+    is_c_integer_constant_expression);
+}
+
+static bool is_c_void_null_pointer_constant(
+  const exprt &expr, const namespacet &ns)
+{
+  if(expr.type().id() != ID_pointer)
+    return false;
+  const auto &base = to_pointer_type(expr.type()).base_type();
+  if(base.id() != ID_empty || c_qualifierst(base) != c_qualifierst(void_type()))
+    return false;
+  if(
+    expr.id() != ID_typecast || expr.operands().size() != 1 ||
+    !is_c_integer_constant_expression(to_typecast_expr(expr).op()))
+    return false;
+  const auto value = simplify_expr(expr, ns);
+  return value.is_constant() && to_constant_expr(value).is_null_pointer();
+}
