+// Private pointer-difference check; qualification is tracked separately.
+#ifndef CPROVER_ANSI_C_POINTER_DIFFERENCE_OVERFLOW_H
+#define CPROVER_ANSI_C_POINTER_DIFFERENCE_OVERFLOW_H
+
+#include <util/arith_tools.h>
+#include <util/c_types.h>
+#include <util/namespace.h>
+#include <util/pointer_expr.h>
+#include <util/pointer_offset_size.h>
+#include <util/pointer_predicates.h>
+#include <util/std_expr.h>
+
+#include <algorithm>
+#include <optional>
+#include <string>
+
+namespace vg_pointer_difference
+{
+struct resultt
+{
+  std::optional<exprt> condition;
+  std::string unsupported_reason;
+};
+
+inline resultt unsupported(const char *reason)
+{
+  return {std::nullopt, reason};
+}
+
+// Check completeness before asking the size helper, which does not itself
+// reject every incomplete type. Pointers are complete without their pointee.
+inline bool complete_type(
+  const typet &type, const namespacet &ns, std::size_t &remaining)
+{
+  if(remaining == 0)
+    return false;
+  --remaining;
+  const auto &id = type.id();
+  if(type.get_bool(ID_incomplete) || id == ID_empty || id == ID_code)
+    return false;
+  if(id == ID_struct_tag)
+    return complete_type(ns.follow_tag(to_struct_tag_type(type)), ns, remaining);
+  if(id == ID_union_tag)
+    return complete_type(ns.follow_tag(to_union_tag_type(type)), ns, remaining);
+  if(id == ID_c_enum_tag)
+    return complete_type(ns.follow_tag(to_c_enum_tag_type(type)), ns, remaining);
+  if(id == ID_array)
+  {
+    const auto &array = to_array_type(type);
+    const auto length = numeric_cast<mp_integer>(array.size());
+    return length.has_value() && *length >= 0 &&
+           complete_type(array.element_type(), ns, remaining);
+  }
+  if(id == ID_vector)
+  {
+    const auto &vector = to_vector_type(type);
+    const auto length = numeric_cast<mp_integer>(vector.size());
+    return length.has_value() && *length >= 0 &&
+           complete_type(vector.element_type(), ns, remaining);
+  }
+  if(id == ID_struct || id == ID_union)
+  {
+    for(const auto &component : to_struct_union_type(type).components())
+      if(!complete_type(component.type(), ns, remaining))
+        return false;
+    return true;
+  }
+  if(id == ID_complex)
+    return complete_type(to_complex_type(type).subtype(), ns, remaining);
+  if(id == ID_c_enum)
+    return complete_type(to_c_enum_type(type).underlying_type(), ns, remaining);
+  return id == ID_pointer || id == ID_bool || id == ID_c_bool ||
+         id == ID_signedbv || id == ID_unsignedbv || id == ID_bv ||
+         id == ID_floatbv || id == ID_fixedbv || id == ID_c_bit_field;
+}
+
+/// Build an overflow predicate, leaving pointer validity to the existing
+/// pointer checks. A missing condition is unsupported, never a violation.
+/// The marker preserves runtime pointer-offset extraction across GOTO files;
+/// no object-bit configuration is embedded in this expression.
+inline resultt no_overflow(const binary_exprt &expr, const namespacet &ns)
+{
+  if(
+    expr.id() != ID_minus || expr.operands().size() != 2 ||
+    (expr.type().id() != ID_signedbv &&
+     expr.type().id() != ID_unsignedbv))
+    return unsupported("expected an integer-valued binary pointer difference");
+
+  const auto &lhs = expr.lhs();
+  const auto &rhs = expr.rhs();
+  if(
+    lhs.type().id() != ID_pointer || rhs.type().id() != ID_pointer ||
+    lhs.type() != rhs.type())
+    return unsupported("pointer operand types differ or are not pointers");
+
+  constexpr std::size_t max_width = 4096;
+  const auto pointer_width = to_pointer_type(lhs.type()).get_width();
+  const auto result_width = to_bitvector_type(expr.type()).get_width();
+  if(
+    pointer_width == 0 || pointer_width >= max_width ||
+    result_width == 0 || result_width >= max_width)
+    return unsupported("pointer/result width exceeds the private check limit");
+
+  const auto &pointee = to_pointer_type(lhs.type()).base_type();
+  std::size_t type_budget = 256;
+  if(!complete_type(pointee, ns, type_budget))
+    return unsupported("pointee is incomplete, dynamic or exceeds type budget");
+  const auto element_size = pointer_offset_size(pointee, ns);
+  if(!element_size.has_value() || *element_size <= 0)
+    return unsupported("pointee has no known positive static byte size");
+  if(*element_size >= power(2, max_width - 1))
+    return unsupported("element size exceeds the private check width limit");
+
+  // Both offsets are runtime zero-extended bit patterns of at most P bits.
+  // P+1 signed bits suffice for their exact difference. R+1 also covers an
+  // unsigned R-bit result bound. The positive divisor must fit without loss.
+  const auto divisor_bits = address_bits(*element_size + 1);
+  const auto wide_width = std::max(
+    {pointer_width + 1, result_width + 1, divisor_bits + 1});
+  const signedbv_typet wide_type(wide_width);
+  pointer_offset_exprt lhs_offset(lhs, wide_type);
+  pointer_offset_exprt rhs_offset(rhs, wide_type);
+  lhs_offset.set("C_preserve_pointer_offset", true);
+  rhs_offset.set("C_preserve_pointer_offset", true);
+
+  const minus_exprt byte_difference(lhs_offset, rhs_offset);
+  const div_exprt element_difference(
+    byte_difference, from_integer(*element_size, wide_type));
+  const integer_bitvector_typet result_type(expr.type().id(), result_width);
+  const and_exprt in_range(
+    binary_relation_exprt(
+      element_difference,
+      ID_ge,
+      from_integer(result_type.smallest(), wide_type)),
+    binary_relation_exprt(
+      element_difference,
+      ID_le,
+      from_integer(result_type.largest(), wide_type)));
+  return {implies_exprt(same_object(lhs, rhs), in_range), ""};
+}
+} // namespace vg_pointer_difference
+
+#endif // CPROVER_ANSI_C_POINTER_DIFFERENCE_OVERFLOW_H
