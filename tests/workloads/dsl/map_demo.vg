map limits:
{
    capacity: 16
}

action REJECT:
{
    return_type: int
    return: -73
}

mount observe_limit:
{
    location: symbol="observe_limit", args=[uint64, uint64], return=void
    nature: read_point
    behavior:
    {
        map["limits"]["max_upload"] = arg1;
        map["limits"]["very_long_variable_name_for_map_key"] = arg1;
    }
}

mount check_limit:
{
    location: symbol="target_fn", args=[uint64, uint64], return=int
    nature: intercept
    behavior:
    {
        value["limit"] = map["limits"]["very_long_variable_name_for_map_key"];
        if (arg1 > value["limit"]) {
            return block("REJECT");
        }
    }
}
